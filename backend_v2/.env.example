# Configure the same MySQL database and JWT secret as the retained backend.
# This file contains no production credentials. Only backend_v2/.env is loaded.
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_NAME=topic_stock
APP_HOST=0.0.0.0
APP_PORT=8002
APP_RELOAD=false
APP_NAME=FastAPI MySQL Application
APP_VERSION=1.0.0
DEBUG=false

# Outbound HTTP routing. Ambient HTTP(S)_PROXY variables are ignored by default.
# Set OUTBOUND_HTTP_PROXY for an explicit proxy, or enable trust_env deliberately.
OUTBOUND_HTTP_TRUST_ENV=false
OUTBOUND_HTTP_PROXY=

JWT_SECRET=change-me-in-production-use-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
GOOGLE_CLIENT_ID=
PASSWORD_RESET_EXPIRE_MINUTES=60
FRONTEND_PASSWORD_RESET_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Provider credentials are shared; analysis and workers use LLM_MODEL.
# Empty key/model disables LLM calls while health remains available.
LLM_API_KEY=
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=8192
# Structured invocations only; plain chat answers remain text.
LLM_RESPONSE_FORMAT=json_object
LLM_TIMEOUT_SECONDS=900
LLM_MAX_RETRIES=2
LLM_STREAMING=true
LLM_STREAM_CHUNK_TIMEOUT_SECONDS=0
# Chat intent, answers and citation repair use these independent settings.
# Empty CHAT_LLM_MODEL falls back to LLM_MODEL for existing deployments.
CHAT_LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
CHAT_LLM_MAX_TOKENS=2048
CHAT_LLM_TIMEOUT_SECONDS=60
CHAT_LLM_MAX_RETRIES=0
# Operator-supplied cost estimates for budgeted sentiment jobs; not live provider prices.
LLM_INPUT_PRICE_PER_M=0.20
LLM_OUTPUT_PRICE_PER_M=1.20
SENTIMENT_USD_TWD_RATE=32.0
# Overall stock-analysis request deadline, not a second LLM configuration.
ANALYSIS_TIMEOUT_SECONDS=1200
# Optional simulation result directory; default is backend_v2/.state/simulation.
# SIMULATION_CACHE_DIR=C:/path/to/simulation-cache
FINMIND_API_TOKEN=

# One embedding provider/model. The key is independent of LLM_API_KEY.
# Keep the model consistent with the existing collection's ingestion model.
EMBED_API_URL=https://integrate.api.nvidia.com/v1/embeddings
EMBED_API_KEY=
EMBED_MODEL=nvidia/nemotron-3-embed-1b
EMBED_TIMEOUT_SECONDS=60
EMBED_TRUNCATE=NONE

# Keep empty for the current legacy index. Activate only after explicit rebuilding.
NEWS_INDEX_VERSION=
# These are character budgets, not tokenizer counts.
NEWS_CHUNK_MAX_CHARS=800
NEWS_CHUNK_OVERLAP_CHARS=120

# A1 chat and A2 retrieval run inside this FastAPI; no legacy RAG API URL is needed.
# API reads and explicit worker writes use the same HTTP service and collection.
QDRANT_URL=
QDRANT_HOST=
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=news_chunks
QDRANT_TIMEOUT_SECONDS=10
