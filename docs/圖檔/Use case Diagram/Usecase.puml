@startuml 股海明燈系統Use Case Diagram
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false

' 定義左邊的主動參與者
actor "訪客" as Guest
actor "會員" as Member
actor "系統管理員" as Admin

' 會員繼承訪客權限
Guest <|-- Member 

' 定義右邊的被動參與者 (第三方整合服務)
rectangle "<<service>>\n大型語言模型 API" as LLM
rectangle "<<service>>\n台灣證券交易所 (TWSE)" as TWSE
rectangle "<<service>>\n財經新聞數據源" as NewsSource

rectangle "股海明燈系統" {
  ' 前台基礎功能
  usecase "會員註冊" as UC_Register
  usecase "會員登入" as UC_Login
  usecase "忘記密碼" as UC_ForgotPwd
  usecase "股票新聞" as UC_News
  usecase "個股分析" as UC_Info
  usecase "基本股票價格查詢" as UC_Price
  usecase "開關燈(主題切換)" as UC_Theme
  


  ' 前台延伸/輔助功能
  usecase "檢索新聞知識庫" as UC_Source
  usecase "模擬下單" as UC_Trade
  usecase "AI投資顧問" as UC_AI
  usecase "多股比較" as UC_Compare

  ' 後台管理功能
  usecase "管理使用者帳號" as UC_ManageUsers
  usecase "排程自動採集管理" as UC_ManageNews
  usecase "系統狀態與日誌監控" as UC_MonitorStatus
}

' 訪客連線
Guest --> UC_Register
Guest --> UC_Login
Guest --> UC_ForgotPwd
Guest --> UC_Price
Guest --> UC_News
Guest --> UC_Info
Guest --> UC_Theme

' 會員連線
Member --> UC_Trade
Member --> UC_AI
Member --> UC_Compare

' 管理員連線
Admin --> UC_ManageUsers
Admin --> UC_ManageNews
Admin --> UC_MonitorStatus

' 包含關係
UC_AI .> UC_Source : <<include>>

' 第三方服務連線
UC_AI --> LLM : 呼叫 API 生成摘要
UC_Price --> TWSE : 呼叫 OpenAPI 獲取股價
UC_MonitorStatus --> LLM : 監控 Token 消耗與連線狀態
UC_ManageNews --> NewsSource : 每日排程自動採集

@enduml
