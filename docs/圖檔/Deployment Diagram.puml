@startuml
skinparam shadowing false
skinparam node {
    BackgroundColor White
    BorderColor Black
}
skinparam component {
    BackgroundColor White
    BorderColor Black
}
left to right direction

' ==========================================
' 1. 用戶端節點
' ==========================================
node "Web Client (使用者裝置)" as web_client <<device>> {
    component "React UI" as ui <<component>>
}

' ==========================================
' 2. 前端與後端伺服器節點 (本機開發 / 雲端)
' ==========================================
node "Frontend Server" as frontend_server <<device>> {
    component "Next.js API Proxy" as frontend_api <<component>>
}

node "Backend Server" as backend_server <<device>> {
    component "Backend Application" as backend <<component>>
}

' ==========================================
' 3. 資料庫節點
' ==========================================
node "Database Server" as db_node <<device>> {
    component "MySQL Database" as mysql <<component>>
}

' ==========================================
' 4. RAG 微服務叢集 (Docker Compose)
' ==========================================
node "RAG Docker Host" as rag_node <<device>> {
    component "Cloudflared" as cloudflared <<component>>
    component "Reverse Proxy" as nginx <<component>>
    component "RAG Engine" as rag <<component>>
    component "Vector DB" as qdrant <<component>>
}

' ==========================================
' 5. 雲端外部服務
' ==========================================
cloud "External Services" as ext_node <<device>> {
    component "NVIDIA NIM" as ext_llm <<component>>
    component "Google OAuth API" as ext_google <<component>>
    component "TWSE / 鉅亨網" as ext_data <<component>>
}

' ==========================================
' 網路通訊協定與實際連線 (Port / Protocols)
' ==========================================
' 前端交互
web_client --> frontend_server
web_client --> backend_server

frontend_server --> backend_server

' 後端依賴與存取
backend_server --> db_node

' RAG Docker 叢集內部架構與通訊
backend_server --> rag_node
cloudflared --> nginx
nginx --> rag
rag --> qdrant

' AI 推論與爬蟲連線
backend_server --> ext_node
rag_node --> ext_node
@enduml
