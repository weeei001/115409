@startuml
title 圖 7-1-1 系統佈署圖

skinparam defaultFontName "標楷體"
skinparam nodesep 35
skinparam ranksep 60

node "使用者裝置" <<device>> as client {
  node "網頁瀏覽器" <<execution environment>> as browser {
    artifact "前端應用程式" as ui
    artifact "推播服務工作者" as sw
  }
}

node "正式主機" <<device>> as host {
  node "Node.js 22" <<execution environment>> as nodert {
    artifact "前端網站" as web
  }
  node "Python 3.12 / Uvicorn" <<execution environment>> as pyrt {
    artifact "應用程式介面服務" as api
    artifact "排程服務" as jobs
  }
  database "MySQL" as mysql
  database "Qdrant" as qdrant
  artifact "持續部署代理程式" as runner
}

cloud "外部服務" as ext {
  component "語言模型推論服務" as llm
  component "文字嵌入服務" as embed
  component "Google 身分驗證服務" as google
  component "行動推播服務" as fcm
  component "郵件服務" as smtp
  component "證券市場資料來源\n（證交所、櫃買中心、集保結算所）" as market
  component "新聞來源網站\n（鉅亨網、自由時報）" as news
}

cloud "持續整合與部署平台" as gh {
  component "GitHub Actions" as ci
}

ui --> web : «HTTPS»
ui --> api : «HTTPS»
fcm --> sw : «HTTPS»

api --> mysql : «TCP/IP»
api --> qdrant : «HTTP»
api --> llm : «HTTPS»
api --> embed : «HTTPS»
api --> google : «HTTPS»
api --> smtp : «SMTP»

jobs --> mysql : «TCP/IP»
jobs --> qdrant : «HTTP»
jobs --> llm : «HTTPS»
jobs --> embed : «HTTPS»
jobs --> market : «HTTPS»
jobs --> news : «HTTPS»
jobs --> fcm : «HTTPS»

ci ..> runner : «HTTPS»
runner ..> web : «deploy»
runner ..> api : «deploy»

@enduml