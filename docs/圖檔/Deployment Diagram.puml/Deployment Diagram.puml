@startuml
title 股海明燈｜UML 部署圖
skinparam shadowing false
skinparam defaultFontName Microsoft JhengHei
skinparam monochrome true
skinparam linetype ortho
left to right direction

node "使用者裝置" as client <<device>> {
    node "瀏覽器" as browser <<executionEnvironment>>
}

node "Cloudflare\n網站入口" as edge

node "Windows 正式主機" as host <<device>> {
    node "Docker" as docker_runtime <<executionEnvironment>> {
        node "Tunnel 容器" as tunnel_runtime <<executionEnvironment>> {
            artifact "cloudflared" as tunnel <<artifact>>
        }
        node "反向代理容器" as proxy_runtime <<executionEnvironment>> {
            artifact "Nginx" as proxy <<artifact>>
        }
        node "Qdrant 容器\n向量資料庫" as vector_runtime <<executionEnvironment>>
    }
    node "Node.js" as frontend_runtime <<executionEnvironment>> {
        artifact "Next.js 前端" as frontend <<artifact>>
    }
    node "Python" as backend_runtime <<executionEnvironment>> {
        artifact "FastAPI 後端\n包含 RAG 與排程" as backend <<artifact>>
    }
    node "MySQL\n關聯式資料庫" as sql_runtime <<executionEnvironment>>
}

node "外部服務\nAI／行情／新聞" as external

' Solid, undirected associations represent UML communication paths.
browser -- edge : HTTPS
edge -- tunnel_runtime : Tunnel
tunnel_runtime -- proxy_runtime : HTTP
proxy_runtime -- frontend_runtime : HTTP
proxy_runtime -- backend_runtime : HTTP
backend_runtime -- vector_runtime : HTTP
backend_runtime -- sql_runtime : SQL
backend_runtime -- external : HTTPS
@enduml
