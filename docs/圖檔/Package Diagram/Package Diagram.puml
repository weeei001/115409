@startuml

' ==========================================
' 設定外觀
' ==========================================
skinparam packageStyle folder
skinparam rectangle {
    BackgroundColor White
}
skinparam linetype ortho
skinparam shadowing false

' ==========================================
' 定義所有的框框 (資料夾) 
' ==========================================

' 【展現層】代表前端 Next.js，負責與使用者直接互動的畫面與機制
package "Presentation Layer (Next.js)" {
    ' 負責切換網頁路由與提供整個頁面的主架構
    package "pages" as pages
    ' 負責小零件，如按鈕、輸入框等可重複使用的 UI
    package "components" as components
    ' 負責做為工具箱，用來呼叫外部 API 或進行資料轉換
    package "lib" as lib
    ' 負責作為前端的代理伺服器 (BFF)
    package "api (BFF)"
}

' 【服務層】代表我們寫的 FastAPI 後端主系統，是調度的大腦
package "Service Layer (FastAPI)" {
    ' 專門負責接收網頁進來的 HTTP 請求與登入驗證
    package "API & Auth" {
        ' 像是第一線接待員，負責接收請求後分派任務給各部門
        package "routers" as routers
        ' 像是警衛室，負責驗證使用者的帳號密碼與權限 Token
        package "auth" as auth
    }
    ' 負責處理核心的數學運算與真實的商業邏輯 (例如下單、回測分析等)
    package "Core Logic" as corelogic {
        ' 核心處，真正撰寫大多數功能判斷邏輯的地方
        package "services" as services
        ' 多代理人機制，負責控制與協調不同性格的交易 AI 進行決策
        package "agent" as agent
        ' 資料搬運工，負責爬取鉅亨網新聞或股市即時資料
        package "crawler" as crawler
    }
}

' 【AI 模型服務層】專門負責處理大語言模型與文件檢索引擎的獨立區塊
package "AI Model Service" {
    ' 放至 RAG (檢索增強生成) 相關的知識庫與呼叫邏輯
    package "rag" as rag
}

' 【資料持久層】也就是最底層。所有跟「把資料永久存進硬碟或資料庫」有關的守門員
package "Data Persistence Layer" as datalayer {
    ' 專門對資料庫進行新增(C)、讀取(R)、更新(U)、刪除(D)的腳本
    package "crud" as crud
    ' 領域模型：負責定義這個系統中出現的資料「名詞」到底長什麼樣子
    package "Domain Models" as domainmodels {
        ' 規範 API 輸入與輸出的資料格式檢查站 (Pydantic，格式不對就阻擋)
        package "schemas" as schemas
        ' 規範真實 MySQL 資料表裡的表格長什麼樣子 (ORM 模型)
        package "models" as models
    }
}

' ==========================================
' 實體與連線關係
' ==========================================

pages --> components
pages --> lib
components --> lib

lib ..> "api (BFF)"

lib ..> routers
"api (BFF)" ..> routers

routers --> services
routers --> auth
routers --> agent

' 同樣將散落的三條線合併成一條從 routers 出發打向資料層的線
routers --> datalayer

auth --> schemas

services --> agent
services --> schemas

agent --> rag

' 把原本散落的三條線合併成一條從大框框出發的線，畫面更乾淨
corelogic --> crud

' 將原本連向 models 和 schemas 的線，簡化為直接依賴整個 Domain Models
crud --> domainmodels
crud --> auth

@enduml
