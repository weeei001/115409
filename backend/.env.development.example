# Copy to .env.development. Never reuse the production database account or JWT secret.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8002
APP_RELOAD=true
DEBUG=true
JOBS_ENABLED=true
JOBS_INTERVAL_MINUTES=30
JOBS_RAG_DELAY_MINUTES=10
JOBS_MARKET_TIME=17:00
JOBS_START_DATE=2021-01-01
JOBS_IMPACT_LIMIT=100
JOBS_IMPACT_MAX_COST_USD=0.50
# Maximum generation time per stock/date during brief warmup.
JOBS_BRIEF_TIMEOUT_SECONDS=180
# JOBS_IMPACT_SINCE=2026-01-01
CORS_ALLOW_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=topic_stock_dev
DATABASE_PASSWORD=
DATABASE_NAME=topic_stock_dev
JWT_SECRET=
FRONTEND_PASSWORD_RESET_URL=http://127.0.0.1:3000/reset-password

# Optional providers: configure development credentials explicitly.
ANALYSIS_LLM_API_KEY=
ANALYSIS_LLM_BASE_URL=
ANALYSIS_LLM_MODEL=
STREAM_LLM_API_KEY=
STREAM_LLM_BASE_URL=
STREAM_LLM_MODEL=
EMBED_API_KEY=
EMBED_API_URL=
EMBED_MODEL=
QDRANT_URL=
QDRANT_HOST=
QDRANT_API_KEY=
QDRANT_COLLECTION=news_chunks_v1_dev
NEWS_INDEX_VERSION=news-v1
FINMIND_API_TOKEN=
GOOGLE_CLIENT_ID=
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
