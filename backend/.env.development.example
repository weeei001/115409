# 複製為 .env.development；使用獨立的開發資料庫帳號及 JWT 金鑰。
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8002
APP_RELOAD=true
JOBS_ENABLED=true
JOBS_MARKET_TIME=17:00
JOBS_START_DATE=2021-01-01
JOBS_IMPACT_LIMIT=100
JOBS_IMPACT_MAX_COST_USD=0.50
# 個股簡報預熱時，每檔股票及日期的生成時間上限。
JOBS_BRIEF_TIMEOUT_SECONDS=180
# JOBS_IMPACT_SINCE=2026-01-01
# Feed settled reviews of past briefs back into new ones: empty is off, * is every stock,
# or codes such as 2330,2454.
# TEXT_BRIEF_LESSONS_SYMBOLS=
# Reviews (one model call each) written per warmup run; 0 writes none, while briefs still read existing ones.
# JOBS_LESSONS_LIMIT=30
CORS_ALLOW_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=topic_stock_dev
DATABASE_PASSWORD=
DATABASE_NAME=topic_stock_dev
JWT_SECRET=
FRONTEND_PASSWORD_RESET_URL=http://127.0.0.1:3000/reset-password

# 新聞分析、個股分析與對話 AI 共用此模型、端點及金鑰；請設定開發用憑證。
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# 對話可獨立調整 token、單次模型逾時、重試及整輪時間上限。
CHAT_LLM_MAX_TOKENS=8192
CHAT_LLM_TIMEOUT_SECONDS=60
CHAT_LLM_MAX_RETRIES=0
CHAT_REQUEST_TIMEOUT_SECONDS=60
EMBED_API_KEY=
EMBED_API_URL=
EMBED_MODEL=
QDRANT_URL=
QDRANT_HOST=
QDRANT_API_KEY=
QDRANT_COLLECTION=news_chunks_v1_dev
NEWS_INDEX_VERSION=news-v1
GOOGLE_CLIENT_ID=
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# 使用獨立的 Firebase 開發專案。
NOTIFICATIONS_ENABLED=false
FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_CREDENTIALS_FILE=
# 通知點擊連結使用的前端 HTTPS 來源。
FCM_WEB_ORIGIN=
