# Long-running stock analysis LLM (Bob's default model is google/gemma-4-31b-it)
ANALYSIS_LLM_API_KEY=
ANALYSIS_LLM_BASE_URL=
ANALYSIS_LLM_MODEL=

# Streaming LLM for chat; falls back to ANALYSIS_LLM_* when all three are empty
STREAM_LLM_API_KEY=
STREAM_LLM_BASE_URL=
STREAM_LLM_MODEL=

# Embedding service
EMBED_API_KEY=
EMBED_API_URL=
EMBED_MODEL=

# Database
DATABASE_HOST=
DATABASE_PORT=3306
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=

# Qdrant (QDRANT_HOST + QDRANT_PORT=6333 can be used instead of QDRANT_URL)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=news_chunks_v1
NEWS_INDEX_VERSION=news-v1

# FinMind jobs
FINMIND_API_TOKEN=

# Application listener
APP_HOST=127.0.0.1
APP_PORT=8002
APP_RELOAD=false

# Authentication
JWT_SECRET=
GOOGLE_CLIENT_ID=
FRONTEND_PASSWORD_RESET_URL=

# SMTP password-reset mail (port 587 and TLS are the defaults)
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional Firebase notifications; credential files remain machine-local.
NOTIFICATIONS_ENABLED=false
FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_CREDENTIALS_FILE=
FCM_WEB_ORIGIN=
