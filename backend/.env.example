# 資料庫配置
DATABASE_HOST=localhost
DATABASE_USER=your_username
DATABASE_PASSWORD=your_password
DATABASE_NAME=topic_stock
DATABASE_PORT=3306

# 應用配置
APP_NAME=FastAPI MySQL Application
APP_VERSION=1.0.0
DEBUG=True
APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=True

NIM_API_KEY=nvapi-your-key-here
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL_PRIMARY=qwen/qwen2.5-coder-32b-instruct
NIM_MODEL_SECONDARY=qwen/qwen2.5-7b-instruct
NIM_DEFAULT_MODEL=primary

# 新聞 RAG API（選填）
RAG_API_URL=
RAG_API_TIMEOUT=10


# JWT（請改為強隨機字串）
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Google Sign-In：後端驗證 id_token 用（Google Cloud Console OAuth 2.0 Client ID；多個以逗號分隔）
GOOGLE_CLIENT_ID=

# Forgot / reset password (optional SMTP)
PASSWORD_RESET_EXPIRE_MINUTES=60
# Full URL of frontend reset page, no query string, e.g. https://app.example.com/reset-password
FRONTEND_PASSWORD_RESET_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=True