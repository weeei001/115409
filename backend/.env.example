# 資料庫配置
DATABASE_HOST=localhost
DATABASE_USER=your_username
DATABASE_PASSWORD=your_password
DATABASE_NAME=topic_stock
DATABASE_PORT=3306

# 應用配置
APP_NAME=FastAPI MySQL Application
APP_VERSION=1.0.0
DEBUG=True
APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=True

# NVIDIA NIM LLM 配置
NIM_API_KEY=nvapi-your-key-here
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=meta/llama-3.1-70b-instruct

# 新聞 RAG API 配置（選填，留空則使用本地 DB 新聞）
RAG_API_URL=
RAG_API_KEY=
RAG_API_TIMEOUT=10

# 爬蟲與排程（TWSE／鉅亨／收盤後排程）之腳本路徑、執行時間、股票清單等
# 已固定於 crawler/*.py 與 crawler/scheduler_utils.py 頂部常數，無需在此設定。