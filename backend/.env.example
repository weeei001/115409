# 新聞分析、個股分析與對話 AI 共用此模型、端點及金鑰。
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# 對話可獨立調整 token、單次模型逾時、重試及整輪時間上限。
CHAT_LLM_MAX_TOKENS=8192
CHAT_LLM_TIMEOUT_SECONDS=85
CHAT_LLM_MAX_RETRIES=0
CHAT_LLM_REASONING_EFFORT=low
CHAT_REQUEST_TIMEOUT_SECONDS=90

# 向量嵌入服務
EMBED_API_KEY=
EMBED_API_URL=
EMBED_MODEL=
EMBED_API_STYLE=nvidia

# 資料庫
DATABASE_HOST=
DATABASE_PORT=3306
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=

# Qdrant（也可使用 QDRANT_HOST 與 QDRANT_PORT=6333 代替 QDRANT_URL）
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=news_chunks_v1
NEWS_INDEX_VERSION=news-v1


# 應用程式監聽設定
APP_HOST=127.0.0.1
APP_PORT=8002
APP_RELOAD=false

# Independent schedules in Asia/Taipei: news :00, indexing :10, events :20 each hour.
# Briefs cover all supported stocks daily. Missed slots are not replayed after restart.
JOBS_ENABLED=true
# Daily market snapshots: five hourly weekday runs, plus Mon-Sat 08:40 catch-up.
JOBS_MARKET_TIME=17:40
JOBS_BRIEF_TIME=22:30
JOBS_IMPACT_LIMIT=100
JOBS_IMPACT_MAX_COST_USD=0.50

# 驗證設定
JWT_SECRET=
GOOGLE_CLIENT_ID=
FRONTEND_PASSWORD_RESET_URL=

# SMTP 密碼重設郵件（預設通訊埠為 587，並啟用 TLS）
# SMTP_FROM 可填 noreply@example.com 或「股海明燈 <noreply@example.com>」；未填名稱時顯示「股海明燈」。
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Firebase 通知為選用功能；憑證檔案僅存放於本機。
NOTIFICATIONS_ENABLED=false
FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_CREDENTIALS_FILE=
FCM_WEB_ORIGIN=
