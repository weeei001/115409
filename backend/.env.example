# 資料庫設定
DATABASE_HOST=localhost
DATABASE_USER=your_username
DATABASE_PASSWORD=your_password
DATABASE_NAME=topic_stock
DATABASE_PORT=3306

# 應用程式設定
APP_NAME=FastAPI MySQL Application
APP_VERSION=1.0.0
DEBUG=True
APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=True

# NVIDIA NIM / Advisor LLM
NIM_API_KEY=nvapi-your-key-here
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
ADVISOR_LLM_MODEL=deepseek-ai/deepseek-v4-pro
ADVISOR_LLM_TEMPERATURE=0.2
ADVISOR_LLM_MAX_COMPLETION_TOKENS=8192
ADVISOR_LLM_RESPONSE_FORMAT=json_object

# 新聞 / RAG API
RAG_API_URL=
RAG_API_KEY=
RAG_API_TIMEOUT=10

# JWT 設定
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Google Sign-In
GOOGLE_CLIENT_ID=

# 密碼重設與 SMTP
PASSWORD_RESET_EXPIRE_MINUTES=60
FRONTEND_PASSWORD_RESET_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=True
