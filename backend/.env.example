# 新聞分析、個股分析與對話 AI 共用此模型、端點及金鑰。
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# 對話可獨立調整 token、單次模型逾時、重試及整輪時間上限。
CHAT_LLM_MAX_TOKENS=8192
CHAT_LLM_TIMEOUT_SECONDS=60
CHAT_LLM_MAX_RETRIES=0
CHAT_REQUEST_TIMEOUT_SECONDS=60

# 向量嵌入服務
EMBED_API_KEY=
EMBED_API_URL=
EMBED_MODEL=

# 資料庫
DATABASE_HOST=
DATABASE_PORT=3306
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=

# Qdrant（也可使用 QDRANT_HOST 與 QDRANT_PORT=6333 代替 QDRANT_URL）
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=news_chunks_v1
NEWS_INDEX_VERSION=news-v1


# 應用程式監聽設定
APP_HOST=127.0.0.1
APP_PORT=8002
APP_RELOAD=false

# 驗證設定
JWT_SECRET=
GOOGLE_CLIENT_ID=
FRONTEND_PASSWORD_RESET_URL=

# SMTP 密碼重設郵件（預設通訊埠為 587，並啟用 TLS）
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Firebase 通知為選用功能；憑證檔案僅存放於本機。
NOTIFICATIONS_ENABLED=false
FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_CREDENTIALS_FILE=
FCM_WEB_ORIGIN=
