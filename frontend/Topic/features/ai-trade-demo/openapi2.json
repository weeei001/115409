            },
            "title": {
              "type": "string",
              "title": "Title",
              "description": "新聞標題"
            },
            "summary": {
              "type": "string",
              "title": "Summary",
              "description": "命中的新聞片段內文（chunk 全文，非摘要）"
            },
            "timestamp": {
              "type": "string",
              "title": "Timestamp",
              "description": "發布時間（YYYY-MM-DD HH:MM:SS），保證 ≤ as_of"
            },
            "url": {
              "type": "string",
              "title": "Url",
              "description": "原始新聞連結"
            },
            "publisher": {
              "type": "string",
              "title": "Publisher",
              "description": "發布媒體的可讀名稱，由 ingest 階段寫入的 `source` 欄位對照而來（見 get_source_name）。查無對照時為原始 source 值，缺欄位時為空字串。呼叫端若要顯示「這句話的來源是誰」，用這個欄位，不要自行從 url 猜。",
              "default": "",
              "examples": [
                "鉅亨網"
              ]
            },
            "kind": {
              "type": "string",
              "title": "Kind",
              "description": "資料性質：\n- `general`：一般新聞檢索路命中（個股）\n- `guidance`：財測／法說會展望檢索路命中（個股）\n- `market`：大盤／總經脈絡，與個股無直接關聯\n\n注意 `guidance` 僅代表「被財測 query 向量命中」，不保證內容確為公司正式財測，呼叫端應只當作市場展望引用、不得視為已實現的財務數據。\n\n`market` 用來判斷當天的漲跌是否為整體性的，呼叫端不得把它當成個股層級的事件歸因。",
              "default": "general",
              "examples": [
                "general"
              ]
            }
          },
          "type": "object",
          "required": [
            "id",
            "title",
            "summary",
            "timestamp",
            "url"
          ],
          "title": "NewsSource"
        },
        "RegisterRequest": {
          "properties": {
            "username": {
              "type": "string",
              "maxLength": 50,
              "minLength": 2,
              "title": "Username"
            },
            "password": {
              "type": "string",
              "minLength": 4,
              "title": "Password"
            }
          },
          "type": "object",
          "required": [
            "username",
            "password"
          ],
          "title": "RegisterRequest"
        },
        "StockAnalysisRequest": {
          "properties": {
            "symbols": {
              "items": {
                "type": "string"
              },
              "type": "array",
              "title": "Symbols",
              "description": "股票代號列表",
              "examples": [
                [
                  "2330"
                ]
              ]
            },
            "as_of": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "As Of",
              "description": "回測用基準時間點（格式 YYYY-MM-DD 或 YYYY-MM-DD HH:MM:SS），抓取範圍為此時間點往前 lookback_days 天、且不含之後的新聞。不傳則預設為現在。",
              "examples": [
                "2026-06-01"
              ]
            },
            "lookback_days": {
              "type": "integer",
              "title": "Lookback Days",
              "description": "往前回溯的日曆天數，預設 30，上限 120（超出自動夾住）。",
              "default": 30,
              "examples": [60]
            },
            "max_events": {
              "type": "integer",
              "title": "Max Events",
              "description": "每支股票回傳的一般新聞則數上限，預設 10，上限 20（超出自動夾住）。財測（kind=guidance）另有 max(2, max_events//2) 的額度，不佔用此上限。",
              "default": 10,
              "examples": [10]
            }
          },
          "type": "object",
          "required": [
            "symbols"
          ],
          "title": "StockAnalysisRequest",
          "examples": [
            {
              "as_of": "2026-07-13",
              "lookback_days": 60,
              "max_events": 10,
              "symbols": [
                "2330"
              ]
            }
          ]
        },
        "StockAnalysisResponse": {
