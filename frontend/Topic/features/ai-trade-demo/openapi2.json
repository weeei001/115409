        "get": {
          "summary": "Get Simulate Trading Stream",
          "description": "「LLM 每日模擬下單」回測，SSE 即時串流。\n\n每個交易日都是一次獨立的 LLM 呼叫（受 confidence 影響決策風格，無法脫鉤預跑快取），\n故本端點逐日邊算邊推送，讓前端能顯示進度條而不必空等一次完整回應。\n完全相同的 (symbol, start, end, initial_cash, confidence) 五參數會命中結果快取，\n直接重放已算過的結果，不重新呼叫 LLM。\n\nSSE 事件：\n  data: {\"type\":\"init\", \"stock_id\", \"n_trading_days\", \"initial_cash\", \"confidence\", \"cached\"?}\n  data: {\"type\":\"day\", \"date\",\"action\",\"buy_pct\",\"sell_pct\",\"executed_shares\",\"cost\",\n         \"close_price\",\"cash_after\",\"shares_after\",\"portfolio_value\",\"reason\"}  × N\n  data: {\"type\":\"done\", \"metrics\": {...}}\n  data: {\"type\":\"error\", \"message\": \"...\"}",
          "operationId": "get_simulate_trading_stream_api_simulate_trading_stream_get",
          "parameters": [
            {
              "name": "symbol",
              "in": "query",
              "required": false,
              "schema": {
                "type": "string",
                "description": "股票代號，目前僅開放 2330",
                "default": "2330",
                "title": "Symbol"
              },
              "description": "股票代號，目前僅開放 2330"
            },
            {
              "name": "start",
              "in": "query",
              "required": false,
              "schema": {
                "type": "string",
                "description": "回測起始日 YYYY-MM-DD（需在資料有效範圍內，見 /api/health 或錯誤訊息）",
                "default": "2025-01-01",
                "title": "Start"
              },
              "description": "回測起始日 YYYY-MM-DD（需在資料有效範圍內，見 /api/health 或錯誤訊息）"
            },
            {
              "name": "end",
              "in": "query",
              "required": false,
              "schema": {
                "type": "string",
                "description": "回測結束日 YYYY-MM-DD（需在資料有效範圍內）",
                "default": "2026-09-03",
                "title": "End"
              },
              "description": "回測結束日 YYYY-MM-DD（需在資料有效範圍內）"
            },
            {
              "name": "initial_cash",
              "in": "query",
              "required": false,
              "schema": {
                "type": "number",
                "description": "初始資金（10,000 ~ 100,000,000）",
                "default": 1000000,
                "title": "Initial Cash"
              },
              "description": "初始資金（10,000 ~ 100,000,000）"
            },
            {
              "name": "confidence",
              "in": "query",
              "required": false,
              "schema": {
                "type": "integer",
                "maximum": 10,
                "minimum": 1,
                "description": "風險偏好 1(保守)~10(激進)",
                "default": 5,
                "title": "Confidence"
              },
              "description": "風險偏好 1(保守)~10(激進)"
            }
          ],
          "responses": {
            "200": {
              "description": "Successful Response",
              "content": {
                "application/json": {
                  "schema": {
  
                  }
                }
              }
            },
            "422": {
              "description": "Validation Error",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/HTTPValidationError"
                  }
                }
              }
            }
          }
        }
      },
