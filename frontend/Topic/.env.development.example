# Copy to .env.development.local in the development checkout.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8002
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_RAG_API_TIMEOUT_MS=120000

# Firebase web app public configuration; push requires HTTPS (localhost is allowed).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
# Set true only after android/app/google-services.json is configured and Capacitor synced.
NEXT_PUBLIC_ANDROID_PUSH_ENABLED=false
