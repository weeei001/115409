@startuml
skinparam componentStyle uml2
skinparam shadowing false
top to bottom direction

cloud "第三方外部服務" {
    component "NVIDIA\nNIM" as ext_llm
    component "三大法人/上市櫃資料\n(TWSE / 鉅亨網)" as ext_data
    component "身分提供者\n(Google OAuth)" as ext_google
}

database "關聯式資料庫\n(MySQL)" as mysql
database "向量資料庫\n(Qdrant)" as qdrant

package "前端系統 (Frontend Next.js)" {
    component "前端介面應用程式\n(React UI)" as frontend
    component "BFF 代理模組\n(Next.js API)" as bff
}

package "核心後端系統 (Backend FastAPI)" {
    component "後端核心伺服器\n(Core API)" as backend
    component "身分驗證模組\n(Auth)" as auth
    component "交易代理引擎\n(Agent Engine)" as agent
    component "市場資料背景爬蟲\n(Cron Crawler)" as crawler
}

package "RAG 巨集微服務 (News RAG)" {
    component "RAG 檢索生成引擎\n(LangChain)" as rag
}

interface "REST API 介面" as i_rest
interface "BFF API 介面" as i_bff
interface "JWT 驗證介面" as i_auth
interface "決策分析介面" as i_agent
interface "語意檢索介面" as i_rag
interface "SQL 存取介面" as i_sql
interface "向量存取介面" as i_vector

interface "LLM 推論 API" as i_llm_api
interface "Open Data API" as i_data_api
interface "OAuth 驗證端點" as i_oauth

bff -up- i_bff
backend -up- i_rest
auth -up- i_auth
agent -up- i_agent
rag -up- i_rag

mysql -up- i_sql
qdrant -up- i_vector

ext_llm -up- i_llm_api
ext_data -up- i_data_api
ext_google -left- i_oauth

frontend ..> i_bff : Ajax 調用
bff ..> i_rest : API 代理轉發

backend ..> i_auth : 檢驗憑證
backend ..> i_agent : 請求投資策略
backend ..> i_sql : 讀寫訂單/會員資料快取

auth ..> i_oauth : 驗證 Google 登入

agent ..> i_rag : 獲取新聞文本
agent ..> i_llm_api : 呼叫 LLM 進行分析推論

rag ..> i_vector : 讀寫 Embedding 向量
rag ..> i_data_api : 抓取各家財經新聞

crawler ..> i_sql : 寫入盤後市場行情
crawler ..> i_data_api : 爬取台股與三大法人

@enduml
